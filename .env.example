# Copie este arquivo para .env e preencha. NUNCA suba o .env para o GitHub.

# Token do bot: fale com @BotFather no Telegram > /newbot
TELEGRAM_TOKEN=

# ---- IA ----------------------------------------------------------------
# gemini (gratuito pelo Google AI Studio) ou claude (pago pelo Console da Anthropic)
LLM_PROVEDOR=gemini

# Chave do Gemini: https://aistudio.google.com > Get API key
GEMINI_API_KEY=
# Confiram no AI Studio quais modelos aparecem como gratuitos (ou rodem scripts/listar_modelos_gemini.py)
GEMINI_MODELO=gemini-3.8-flash
# Reservas, em ordem, se o principal estiver sobrecarregado (erro 503) ou sem cota (429)
GEMINI_MODELOS_RESERVA=gemini-3.5-flash-lite,gemini-3.6-flash

# Só se usar Claude
ANTHROPIC_API_KEY=
CLAUDE_MODELO=claude-haiku-5-5

# ---- Dados -------------------------------------------------------------
# Chave gratuita do NASA FIRMS: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
FIRMS_FONTES=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT

# Alertas automáticos
RAIO_ALERTA_KM=10
INTERVALO_ALERTA_MIN=30

# 1 = focos SIMULADOS para vídeo/apresentação (as mensagens avisam que é simulação)
MODO_DEMO=0

# Áudio (opcional, precisa do faster-whisper): tiny, base, small, medium
WHISPER_MODELO=small
